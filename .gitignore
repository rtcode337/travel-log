# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# 外部DBへのマイグレーション用の接続情報(雛形は .env.remote.example)。
# 本物のホスト名・パスワードが入るのでコミットしない
/.env.remote

# standalone用composeの実値入りコピー(雛形は docker-compose.standalone.example.yml)。
# この形式は SESSION_SECRET 等を直書きするので、コピーした側はコミットしない
# (.env.example と .env の関係と同じ)
/docker-compose.standalone.yml

# データの置き場(composeのbindマウント先)。この下に db(Postgresの実データ)・
# photos(訪問記録の写真)・exports(エクスポートのZIP)が入る。どれも個人情報を
# 含むため絶対にコミットしない。ディレクトリ自体はdata-initサービスが起動時に
# 作るので.gitkeepは不要。中身ではなくディレクトリごと無視することで、
# postgresユーザー所有で権限が絞られた中身をgitが読みに行かず
# 「could not open directory」警告が出ないようにする
/data/

# MapLibre GL JSのワーカースクリプト(scripts/copy-maplibre-worker.mjsが
# node_modulesからコピーする生成物。理由はlib/maplibre.tsのコメント参照)
/public/maplibre-gl/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
