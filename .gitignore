# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# Postgresの実データ(docker-compose.yml/docker-compose.dev.ymlのbindマウント先)
# 個人情報を含むため絶対にコミットしない。ディレクトリ自体はdb-initサービス
# (docker-compose.yml)が起動時にmkdirするので.gitkeepは不要
/db/data/*

# 訪問記録の写真ファイル(docker-compose.ymlのbindマウント先、lib/photos.ts参照)
# db/data と同じ理由で、中身はコミットせずフォルダだけ .gitkeep で残す
/photos/*
!/photos/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
