# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# standalone用composeの実値入りコピー(雛形は docker-compose.standalone.example.yml)。
# この形式は SESSION_SECRET 等を直書きするので、コピーした側はコミットしない
# (.env.example と .env の関係と同じ)
/docker-compose.standalone.yml

# Postgresの実データ(docker-compose.yml/docker-compose.dev.ymlのbindマウント先)
# 個人情報を含むため絶対にコミットしない。ディレクトリ自体はdb-initサービス
# (docker-compose.yml)が起動時にmkdirするので.gitkeepは不要。中身ではなく
# ディレクトリごと無視することで、postgresユーザー所有で権限が絞られた
# 中身をgitが読みに行かず「could not open directory」警告が出ないようにする
/data/

# 訪問記録の写真ファイル(docker-compose.ymlのbindマウント先、lib/photos.ts参照)
# data と同じ理由で、中身はコミットせずフォルダだけ .gitkeep で残す
/photos/*
!/photos/.gitkeep

# MapLibre GL JSのワーカースクリプト(scripts/copy-maplibre-worker.mjsが
# node_modulesからコピーする生成物。理由はlib/maplibre.tsのコメント参照)
/public/maplibre-gl/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
