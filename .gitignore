# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# Postgresの実データ(docker-compose.yml/docker-compose.dev.ymlのbindマウント先)
# 個人情報を含むため絶対にコミットしない。ただしbindマウント先のフォルダ自体は
# cloneした時点で存在してほしい(Synology Container Manager等はマウント先の
# ディレクトリを自動作成してくれないため)ので .gitkeep だけは残す
/db/data/*
!/db/data/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
