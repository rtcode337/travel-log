# 外部のPostgres(Supabase等)へスキーマ・マイグレーションを適用するための接続情報
# (scripts/migrate-remote.sh が --env-file で読む)。
# このファイルをコピーして .env.remote を作り、値を入れる(.env.remote はgitignore済み)。
#
# Supabaseの場合、値は Dashboard → Connect の "Session pooler" の接続文字列から拾う。
# **Transaction pooler(6543)ではなくSession pooler(5432)を使うこと**
# (理由は scripts/migrate-remote.sh のコメント)。
PGHOST=aws-0-ap-northeast-1.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.xxxxxxxxxxxxxxxxxxxx
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require
